[Unit]
Description=pdbd datapath netns (slot %i)
# PartOf: Requires is start-only, so this makes `systemctl stop <target>` reclaim the whole slot
PartOf=pdbd.datapath@%i.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{bin}}/ip netns add pdbd.%i
ExecStartPost={{bin}}/ip -n pdbd.%i link set lo up
ExecStop={{bin}}/ip netns del pdbd.%i
