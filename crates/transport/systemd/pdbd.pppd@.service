[Unit]
Description=pdbd pppd peer (slot %i)
Requires=pdbd.socat@%i.service
After=pdbd.socat@%i.service

[Service]
EnvironmentFile={{ envfile }}
ExecStartPre={{ sh }} -c 'until [ -e /run/pdbd/%i/b ]; do sleep 0.1; done'
# nolock: dedicated per-slot PTYs; pppd's UUCP lock keys on the basename (b), so parallel slots would collide
ExecStart={{ pppd }} /run/pdbd/%i/b ${PDBD_BAUD} noauth local nodetach nocrtscts novj noccp nolock lcp-echo-interval 0 unit %i 10.0.%i.2:10.0.%i.1
